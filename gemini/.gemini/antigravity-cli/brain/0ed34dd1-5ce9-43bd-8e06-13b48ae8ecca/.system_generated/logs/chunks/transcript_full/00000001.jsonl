{"step_index":101,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-22T10:15:10Z","content":"Created At: 2026-08-22T13:15:10+03:00\nCompleted At: 2026-08-22T13:15:11+03:00\nFile Path: `file:///home/gaitano/01-studio/01-src/moringa-marines/module-6/Mealy-Front---End-build-/src/components/DailyMealOptions/DailyMealOptions.jsx`\nTotal Lines: 52\nTotal Bytes: 1608\nShowing lines 1 to 52\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { useState } from \"react\";\n2: import { useDailyOptions } from \"../../contexts/DailyOptionsContext\";\n3: import \"./DailyMealOptions.css\";\n4: import MealOptionCard from \"../MealOptionCard/MealOptionCard\";\n5: \n6: function DailyMealOptions() {\n7:   const { options: dailyOptions } = useDailyOptions();\n8:   const [selections, setSelections] = useState({}); // Track card selection state\n9: \n10:   const selectedCount = Object.values(selections).reduce((a, b) => a + b, 0);\n11:   const selectedTotal = dailyOptions\n12:     .filter((o) => selections[o.id])\n13:     .reduce((sum, o) => sum + o.price * selections[o.id], 0);\n14: \n15:   return (\n16:     <section className=\"daily-options\">\n17:       <h2>Daily Options</h2>\n18:       <div className=\"daily-options-grid\">\n19:         {dailyOptions.map((option) => {\n20:           const qty = selections[option.id] || 0;\n21:           return (\n22:             <MealOptionCard\n23:               key={option.id}\n24:               option={option}\n25:               qty={qty}\n26:               setSelections={setSelections}\n27:             />\n28:           );\n29:         })}\n30:       </div>\n31: \n32:       {selectedCount > 0 && (\n33:         <div className=\"cart-float\">\n34:           <div className=\"cart-float-info\">\n35:             <span className=\"cart-float-count\">\n36:               {selectedCount} item{selectedCount > 1 ? \"s\" : \"\"}\n37:             </span>\n38:             <span className=\"cart-float-total\">\n39:               KSh {selectedTotal.toLocaleString()}\n40:             </span>\n41:           </div>\n42:           <button className=\"btn-primary btn-primary--inline cart-float-btn\">\n43:             Place Order\n44:           </button>\n45:         </div>\n46:       )}\n47:     </section>\n48:   );\n49: }\n50: \n51: export default DailyMealOptions;\n52: \nThe above content shows the entire, complete file contents of the requested file.\n"}
