: 1755938142:0;DB="$HOME/.newsboat/cache.db"\
\
sqlite3 "$DB" <<'EOF'\
.mode list\
.headers off\
SELECT rss_feed.title || ': ' || rss_item.title\
FROM rss_item\
JOIN rss_feed ON rss_feed.rssurl = rss_item.feedurl\
WHERE rss_item.unread = 1\
ORDER BY pubDate DESC\
LIMIT 5;\
EOF
