ndleChange}\r\n          />\r\n        </div>\r\n\r\n        <Btn type=\"submit\">Log In</Btn>\r\n      </form>\r\n\r\n      <div className=\"auth-footer\">\r\n        <span>Don't have an account?</span>\r\n        <a href=\"/signup\">Sign Up</a>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default LoginCard;\r\n\n"}
