{"step_index":127,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-19T11:34:24Z","content":"Created At: 2026-11-19T14:34:24+03:00\nCompleted At: 2026-11-19T14:34:24+03:00\nCreated At: 2026-11-19T14:34:24+03:00\nCompleted At: 2026-11-19T14:34:24+03:00\nShowing lines 251-412 of 412\n251:     kb_model =\n252:     kb_options = compose:ralt,caps:escape\n253:     kb_rules =\n254: \n255:     follow_mouse = 1\n256: \n257:     sensitivity = 0 # -1.0 - 1.0, 0 means no modification.\n258: \n259:     touchpad {\n260:         natural_scroll = false\n261:     }\n262: }\n263: \n264: # See https://wiki.hypr.land/Configuring/Gestures\n265: gesture = 3, horizontal, workspace\n266: \n267: # Example per-device config\n268: # See https://wiki.hypr.land/Configuring/Keywords/#per-device-input-configs for more\n269: device {\n270:     name = epic-mouse-v1\n271:     sensitivity = -0.5\n272: }\n273: \n274: device {\n275:     name = at-translated-set-2-keyboard\n276:     enabled = false\n277: }\n278: \n279: \n280: ###################\n281: ### KEYBINDINGS ###\n282: ###################\n283: \n284: # See https://wiki.hypr.land/Configuring/Keywords/\n285: $mainMod = SUPER # Sets \"Windows\" key as main modifier\n286: \n287: bind = $mainMod, I, exec, hyprctl layers > /tmp/layers.txt\n288: \n289: # Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more\n290: bind = $mainMod, Return, exec, $terminal\n291: bind = $mainMod, Z, exec, $browser\n292: bind = $mainMod, E, exec, $fileManager\n293: bind = $mainMod, D, exec, $menu\n294: bind = $mainMod SHIFT, S, exec, $screenshotManager\n295: bind = $mainMod SHIFT, Q, killactive,\n296: bind = $mainMod SHIFT, R, exec, hyprctl reload,\n297: bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit\n298: bind = $mainMod, F, fullscreen, 0\n299: #bind = $mainMod, V, togglefloating,\n300: bind = $mainMod, P, pseudo, # dwindle\n301: bind = $mainMod, V, layoutmsg, togglesplit # dwindle\n302: \n303: # Move focus with mainMod + vim motions\n304: bind = $mainMod, H, movefocus, l\n305: bind = $mainMod, J, movefocus, d\n306: bind = $mainMod, K, movefocus, u\n307: bind = $mainMod, L, movefocus, r\n308: \n309: # Move window with mainMod SHIFT + vim motions\n310: bind = $mainMod SHIFT, H, movewindow, l\n311: bind = $mainMod SHIFT, J, movewindow, d\n312: bind = $mainMod SHIFT, K, movewindow, u\n313: bind = $mainMod SHIFT, L, movewindow, r\n314: \n315: # Resize windows with mainMod + R and dragging\n316: bindm = $mainMod, R, resizewindow\n317: \n318: # Switch workspaces with mainMod + [0-9]\n319: bind = $mainMod, 1, workspace, 1\n320: bind = $mainMod, 2, workspace, 2\n321: bind = $mainMod, 3, workspace, 3\n322: bind = $mainMod, 4, workspace, 4\n323: bind = $mainMod, 5, workspace, 5\n324: bind = $mainMod, 6, workspace, 6\n325: bind = $mainMod, 7, workspace, 7\n326: bind = $mainMod, 8, workspace, 8\n327: bind = $mainMod, 9, workspace, 9\n328: bind = $mainMod, 0, workspace, 10\n329: \n330: # Move active window to a workspace with mainMod + SHIFT + [0-9]\n331: bind = $mainMod SHIFT, 1, movetoworkspace, 1\n332: bind = $mainMod SHIFT, 2, movetoworkspace, 2\n333: bind = $mainMod SHIFT, 3, movetoworkspace, 3\n334: bind = $mainMod SHIFT, 4, movetoworkspace, 4\n335: bind = $mainMod SHIFT, 5, movetoworkspace, 5\n336: bind = $mainMod SHIFT, 6, movetoworkspace, 6\n337: bind = $mainMod SHIFT, 7, movetoworkspace, 7\n338: bind = $mainMod SHIFT, 8, movetoworkspace, 8\n339: bind = $mainMod SHIFT, 9, movetoworkspace, 9\n340: bind = $mainMod SHIFT, 0, movetoworkspace, 10\n341: \n342: # Special workspace (scratchpad)\n343: bind = $mainMod, S, togglespecialworkspace, magic\n344: bind = $mainMod ALT, S, movetoworkspace, special:magic\n345: bind = $mainMod ALT SHIFT, S, movetoworkspace, e+0\n346: \n347: # Scroll through existing workspaces with mainMod + scroll\n348: bind = $mainMod, mouse_down, workspace, e+1\n349: bind = $mainMod, mouse_up, workspace, e-1\n350: \n351: # Laptop multimedia keys for volume and LCD brightness\n352: bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+\n353: bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-\n354: #bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\n355: bindel = , semicolon, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\n356: bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\n357: bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 1%+\n358: bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 1%-\n359: \n360: # Requires playerctl\n361: bindl = , XF86AudioNext, exec, playerctl next\n362: bindl = , XF86AudioPause, exec, playerctl play-pause\n363: bindl = , XF86AudioPlay, exec, playerctl play-pause\n364: bindl = , XF86AudioPrev, exec, playerctl previous\n365: \n366: # Move mouse cursor\n367: bind = $mainMod, Up, exec, ydotool mousemove -x 0 -y -10\n368: bind = $mainMod, Down, exec, ydotool mousemove -x 0 -y 10\n369: bind = $mainMod, Left, exec, ydotool mousemove -x -10 -y 0\n370: bind = $mainMod, Right, exec, ydotool mousemove -x 10 -y 0\n371: \n372: ##############################\n373: ### WINDOWS AND WORKSPACES ###\n374: ##############################\n375: \n376: # See https://wiki.hypr.land/Configuring/Window-Rules/ for more\n377: # See https://wiki.hypr.land/Configuring/Workspace-Rules/ for workspace rules\n378: \n379: # Example windowrules that are useful\n380: \n381: windowrule {\n382:     # Ignore maximize requests from all apps. You'll probably like this.\n383:     name = suppress-maximize-events\n384:     match:class = .*\n385: \n386:     suppress_event = maximize\n387: }\n388: \n389: windowrule {\n390:     # Fix some dragging issues with XWayland\n391:     name = fix-xwayland-drags\n392:     match:class = ^$\n393:     match:title = ^$\n394:     match:xwayland = true\n395:     match:float = true\n396:     match:fullscreen = false\n397:     match:pin = false\n398: \n399:     no_focus = true\n400: }\n401: \n402: # Hyprland-run windowrule\n403: windowrule {\n404:     name = move-hyprland-run\n405: \n406:     match:class = hyprland-run\n407: \n408:     move = 20 monitor_h-120\n409:     float = yes\n410: }\n411: \n412: env = XDG_DATA_DIRS,$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"}
