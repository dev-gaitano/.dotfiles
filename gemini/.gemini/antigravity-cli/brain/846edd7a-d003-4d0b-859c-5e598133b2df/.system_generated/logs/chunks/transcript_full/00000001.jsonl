from \"../../hooks/useIsMobile\";\nimport type { PolaroidFilmProps } from \"../../types/MeshImportProps\";\n\ngsap.registerPlugin(ScrollTrigger);\n\n// Rotation constants for scroll animation\nexport const ROTATION_X = Math.PI / 2;\n\nexport const DESKTOP_ROTATION_START = {\n  y: 12.5 * (Math.PI / 180),\n  z: -8 * (Math.PI / 180),\n};\n\nexport const DESKTOP_ROTATION_END = {\n  y: -12.5 * (Math.PI / 180),\n  z: 8 * (Math.PI / 180),\n};\n\nexport const MOBILE_ROTATION_START = {\n  y: 0,\n  z: 0,\n};\n\nexport const MOBILE_ROTATION_END = {\n  y: 0,\n  z: 0,\n};\n\nfunction ContactCard({\n  rotationX = ROTATION_X,\n  startY,\n  startZ,\n  endY,\n  endZ,\n  scale,\n}: PolaroidFilmProps) {\n  const cardRef = useRef<Group>(null);\n  const isMobile = useIsMobile();\n\n  // Get scene attribute from model\n  const model = useGLTF(\"/polaroid_film_gaitano_001.glb\");\n  const model_scene = model.scene;\n\n  useEffect(() => {\n    if (!cardRef.current) return;\n\n    const defaultStart = isMobile\n      ? MOBILE_ROTATION_START\n      : DESKTOP_ROTATION_START;\n    const defaultEnd = isMobile ? MOBILE_ROTATION_END : DESKTOP_ROTATION_END;\n\n    const initialY = startY ?? defaultStart.y;\n    const initialZ = startZ ?? defaultStart.z;\n    const finalY = endY ?? defaultEnd.y;\n    const finalZ = endZ ?? defaultEnd.z;\n\n    const ctx = gsap.context(() => {\n      gsap.fromTo(\n        cardRef.current!.rotation,\n        {\n          x: rotationX,\n          y: initialY,\n          z: initialZ,\n        },\n        {\n          x: rotationX,\n          y: finalY,\n          z: finalZ,\n          ease: \"none\",\n          scrollTrigger: {\n            trigger: \"#about\",\n            start: \"top bottom\",\n            end: \"bottom top\",\n            scrub: true,\n            invalidateOnRefresh: true,\n          },\n        }\n      );\n    });\n\n    return () => ctx.revert();\n  }, [isMobile, rotationX, startY, startZ, endY, endZ]);\n\n  // return a primitive element\n  return (\n    <group ref={cardRef} scale={scale}>\n      <primitive object={model_scene} rotation={[0, 0, 0]} />\n    </group>\n  );\n}\n\n// Load the model before it's needed\nuseGLTF.preload(\"/polaroid_film_gaitano_001.glb\");\n\nexport default ContactCard;","StartLine":1,"TargetContent":"import { useGLTF } from \"@react-three/drei\";\nimport type { PolaroidFilmProps } from \"../../types/MeshImportProps\";\n\nfunction ContactCard({\n  rotationX,\n  rotationY,\n  rotationZ,\n  scale,\n}: PolaroidFilmProps) {\n  // Get scene attribute from model\n  const model = useGLTF(\"/polaroid_film_gaitano_001.glb\");\n  const model_scene = model.scene;\n\n  // return a primitive element\n  return (\n    <primitive\n      object={model_scene}\n      scale={scale}\n      rotation={[rotationX, rotationY, rotationZ]}\n    />\n  );\n}\n\n// Load the model before it's needed\nuseGLTF.preload(\"/polaroid_film_gaitano_001.glb\");\n\nexport default ContactCard;","TargetFile":"/home/gaitano/01-studio/01-src/eugene-gaitano/frontend/src/components/ui/ContactCard.tsx","toolAction":"Adding scroll rotation constants to ContactCard","toolSummary":"Update ContactCard.tsx"}}]}
